{
  "scriptCachingPolicy": "CACHE_ONCE",
  "stages": {
    "nodeBootstrapped": [
      {
        "name": "Set cluster MOTD",
        "scriptSource": {
          "scriptLocation": "https://aws-hpc-recipes.s3.us-east-1.amazonaws.com/main/recipes/pcs-scripts/node_lifecycle_demo/assets/set-cluster-motd-v1.0.0.sh"
        },
        "arguments": ["--message", "Welcome to the research cluster"],
        "onError": "CONTINUE",
        "executionPolicy": "EVERY_BOOT"
      },
      {
        "name": "Apply node Name tag",
        "scriptSource": {
          "scriptLocation": "https://aws-hpc-recipes.s3.us-east-1.amazonaws.com/main/recipes/pcs-scripts/node_lifecycle_demo/assets/apply-node-name-tag-v1.0.0.sh"
        },
        "arguments": [],
        "onError": "CONTINUE",
        "executionPolicy": "FIRST_BOOT_ONLY"
      },
      {
        "name": "Prepare HPC node",
        "scriptSource": {
          "scriptLocation": "https://aws-hpc-recipes.s3.us-east-1.amazonaws.com/main/recipes/pcs-scripts/node_lifecycle_demo/assets/prepare-hpc-node-v1.0.0.sh"
        },
        "arguments": ["--nofile", "131072", "--memlock", "unlimited", "--disable-thp"],
        "onError": "TERMINATE",
        "executionPolicy": "EVERY_BOOT"
      },
      {
        "name": "Set up local scratch",
        "scriptSource": {
          "scriptLocation": "https://aws-hpc-recipes.s3.us-east-1.amazonaws.com/main/recipes/pcs-scripts/node_lifecycle_demo/assets/setup-local-scratch-v1.0.0.sh"
        },
        "arguments": ["--mount-point", "/scratch", "--fstype", "ext4"],
        "onError": "CONTINUE",
        "executionPolicy": "EVERY_BOOT"
      }
    ]
  }
}
